// property binding
application: [property]="expression"
types of property: [element property, component property, directive property]
examples:
element property:	<img [src]="vehicle.imageUrl">
component property: <vehicle-detail [vehicle]="currentVehicle"></vehicle-detail>
directive property:	<div [ngClass]="{selected: isSelected}">X-Wing</div>

// (Attribute, class and style) property binding on html elements
element attribute property:	<button [attr.aria-label]="ok">OK</button>
element class property:		<div [class.isStopped]="isStopped">Stopped</div>	// good for css selection!
element style property:		<button [style.color]="isStopped ? 'red' : 'green'" >


// event handling
application: (event-target)="statement"
types of events: [element event, component event]
examples:
element event:		<button (click)="save()">Save</button>
component event:	<vehicle-detail (changed)="vehicleChanged"></vehicle-detail>

