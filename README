                   .subscribe( doSomething() );                   
}


// rxjs Operators 'rxjs/operators'
* head-tail functions piped out of the Observable before a value is emitted to the Observer(s)

of(1, 3, 5)
  .pipe(  
    map(item => item * 2)						// transform
	.map(item => {								// also there is the possibility to throw!
	  if(item === 0) {
        throw new Error('zero detected'); 
	  }
	  return item;
	})
	.tap( item => console.log(item) )			// actions that does not modify the stream
	.take( 2 )									// limits to the *first* n items
  ).subscribe( res => doSomething(res) );


// rxjs how-to: apply CATCH AND REPLACE pattern to handle errors cleanly
* by using the catchError rxjs operator and the EMPTY Observable

products$: Observable<Product[]>;

this.products$ = this.productService.getProducts()
  .pipe(
    catchError( err => {
	  this.errorMessage = err;
	  return EMPTY;
	})
  );
  
