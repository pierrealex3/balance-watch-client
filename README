// @Input() @Output() and @ViewChild(MyComponent)
@Input 		property binding from parent to child component
			<my-child [childProp]="parentProp"></my-child>  @Component export class MyChild { @Input() childProp: ChildPropType;  ... }
@Output 	provide event communication from child to parent component
			<my-child (childEvent)="parentFunction($event)"</my-child> @Component export class Mychild { @Output() childEvent = new EventEmitter<ChildPropType>(); doSomething() : void { this.childEvent.emit(childProp); } }
@ViewChild	access child components method/data from parent
			@Component export class MyParent { @ViewChild(MyChild) childHook: MyChild; }
			

// Template variable references
to reuse a DOM element somewhere else in the same template
ex: 		<input #fax /> <button (click)="callFax(fax.value)">Fax</button>
ex alt: 	<input ref-fax /> <button (click)="callFax(fax.value)">Fax</button>

// template reference variables
ex: <form #form="ngForm">
here #form is the template ref variable pointing to the ngForm directive.

-- view all classes of a dom element by using a template ref var with no value AND calling its className property.
ex: <input #classTest id="abc" ...
	<h3>{{ classTest.className }}</h3>


// reference ngModel properties for validation
note: all ngModel properties have an ng- prefix class equivalent on the target element ex: ng-invalid

<input  [(ngModel)]="myField" ... #myTest="ngModel" >

{{myTest.valid}}
{{myTest.invalid}}

{{myTest.dirty}}
{{myTest.pristine}}
{{myTest.touched}}
{{myTest.untouched}}

// style the invalid controls in the form and/or css - depending on the desired look
<input required [(ngModel)]="myField" ... #myTest="ngModel" >
<div [hidden]="myTest.valid || nameField untouched" class="alert alert-danger">
	This field is required!
</div>

.ng-invalid:not(form).ng-touched {
	border: 1px solid red;
}

//custom validation - pass the NgModel ref into a TS function of the component to see its validity
<input  [(ngModel)]="myField" ... #myTest="ngModel" (blur)="onBlur(myTest)" >

myTest(NgModel m) {
	m.valid;
}


