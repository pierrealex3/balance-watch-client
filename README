// example of how to use Http @angular/http
* log at the service level, then decide what action to take at the ui component level.
import 'rxjs/add/operator/map';
import 'rxjs/add/operator/catch';
import {Observable} from 'rxjs/Observable';
import 'rxjs/add/observable/throw';

a =this.http.get('api/end/point')
	.map( (response:Response) => <MyDtoDomain>response.json() )
	.catch(this.handleError)
	.finally( () => this.cleanupStuff() );
	
private handleError(error: Response) {
  let msg = `status code ${error.status} on url ${error.url}`;
  return Observable.throw(msg);
}

a.subscribe( d => this.something = d, error => this.errorMsg = <any>error )


// rx-js how-to: map individual X elements from an Observable<X[]> - within an Observable.pipe() function
* by understanding that the pipe rxjs operator chain operates on the <T> within Observable<T>, and in the case <T> is actually an array of something, every rxjs operator within the pipe will have to operate on an ARRAY.
* by using rxjs operator methods to operate on the STREAM along with array methods to operate on ARRAY ELEMENTS OF THE OBSERVABLE OF ARRAY

products$ = this.http.get<Product[]>(this.url)
  .pipe(
    map( productArray =>  
	  productArray.map(product => 		// leverage JS array.map function to obtain (input array => array.map => output array)
	  ({									// return a Generic Object
	     ...product, 						// copy everything from array element
		 price: product.price * 1.15,		// individual object field override
		 searchKey: [product.productName]	// individual object field override	    
	  }) as Product							// cast the Generic Object as a TYPED object
	  )
	)
  );


// how-to: build your Observable for consumption by 1.* Observer
* WHEN YOU BUILD AN OBSERVABLE OF SOMETHING, YOU CODE THE INTERACTION WITH THE OBSERVER OF SOMETHING

ex:
const appleStream = new Observable( appleObserver => {
  appleObserver.next( new Apple('Lobo') );
  appleObserver.next( new Apple('MacIntosh') );
  appleObserver.complete();		// the stream is closed
});


