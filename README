npm update // when everything was screwed up compiling after bot updates in github


// built-in directives
[ngStyle]=
[ngClass]="{selected: isSelected}"

// alternative to *ngIf when all we want to do is show|hide something and not play with the DOM
[style.visibility]="isVisible()"

// date pipe
<p> {{ myDate | date:'yMMMd' }} </p>	// with granular info
<p> {{ myDate | date:'medium' }} </p>	// preformatted - look at the docs

// TitleCase pipe
{{ myVar || titlecase }}	// transforms AAA into Aaa


// custom pipe - transform with regex
lookup for @Pipe({ name: 'xxx'})

