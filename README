// example of how to use Http @angular/http
* log at the service level, then decide what action to take at the ui component level.
import 'rxjs/add/operator/map';
import 'rxjs/add/operator/catch';
import {Observable} from 'rxjs/Observable';
import 'rxjs/add/observable/throw';

a =this.http.get('api/end/point')
	.map( (response:Response) => <MyDtoDomain>response.json() )
	.catch(this.handleError)
	.finally( () => this.cleanupStuff() );
	
private handleError(error: Response) {
  let msg = `status code ${error.status} on url ${error.url}`;
  return Observable.throw(msg);
}

a.subscribe( d => this.something = d, error => this.errorMsg = <any>error )

// async pipe - alternative to simplify display - just chain the Observable.catch in the UI component.
@Component
fList: Observable<MyDomain[]>;

